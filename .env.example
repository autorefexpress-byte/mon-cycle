# Connexion Postgres Neon (utiliser la connection string "pooled" fournie par Neon)
DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require

# URL publique ou l'app est deployee (utilisee par Better Auth pour construire les liens)
BETTER_AUTH_URL=https://ton-app.vercel.app

# Chaine aleatoire longue et secrete, generee une seule fois (ex: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-moi

# Origines autorisees a appeler l'API d'authentification (separees par des virgules)
TRUSTED_ORIGINS=https://ton-app.vercel.app

# Envoi des emails de reinitialisation de mot de passe via Brevo (https://www.brevo.com).
# Cle API : Brevo > SMTP & API > Cles API. L'adresse d'EMAIL_FROM doit appartenir
# a un domaine verifie dans Brevo (Expediteurs, domaines et IP dedicees).
BREVO_API_KEY=
EMAIL_FROM=Mon Cycle <noreply@moncycle.nc>
